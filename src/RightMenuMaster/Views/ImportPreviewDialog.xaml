<Window x:Class="RightMenuMaster.Views.ImportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认导入 - 右键菜单管家"
        Width="760" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource ContentBgBrush}">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="确认要导入的菜单项" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="SubtitleText" Style="{StaticResource PageSubtitle}"
                       Text="导入的命令会写入右键菜单并在点击时执行，请先确认来源可信。"/>
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,14,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="同名项：" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <RadioButton x:Name="SkipRadio" Content="跳过" IsChecked="True"
                             VerticalAlignment="Center" Margin="6,0,0,0"/>
                <RadioButton x:Name="OverwriteRadio" Content="覆盖"
                             VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnSelectAll" Style="{StaticResource RoundedButton}"
                        Click="SelectAll_Click" Padding="12,5">
                    <TextBlock Text="全选 / 全不选"/>
                </Button>
                <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <ListView x:Name="ItemList" Style="{StaticResource EntryListView}"
                      BorderThickness="0" Background="Transparent">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                        <GridViewColumn Header="" Width="40">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding Selected, Mode=TwoWay}"
                                              Checked="ItemCheck_Changed" Unchecked="ItemCheck_Changed"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="标题" Width="170"
                                        DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="作用域" Width="130"
                                        DisplayMemberBinding="{Binding ScopeName}"/>
                        <GridViewColumn Header="命令" Width="270">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Command}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="状态" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusText}" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AlreadyExists}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnImport" Style="{StaticResource PrimaryButton}"
                    Click="Import_Click" Padding="22,8">
                <TextBlock x:Name="ImportButtonText" Text="导入"/>
            </Button>
            <Button x:Name="BtnCancel" Style="{StaticResource RoundedButton}"
                    Click="Cancel_Click" Margin="10,0,0,0" Padding="22,8">
                <TextBlock Text="取消"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
