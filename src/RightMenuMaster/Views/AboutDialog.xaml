<Window x:Class="RightMenuMaster.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于" Width="520" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F7F9FC">

    <StackPanel Margin="24,20">
        <StackPanel Orientation="Horizontal">
            <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource AccentBrush}">
                <Path Data="M5,3 L14,12 L10.5,12.8 L13,18.2 L10.6,19.3 L8.2,13.9 L5,16.5 Z"
                      Fill="White" Stretch="Uniform" Width="24" Height="24"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="右键菜单管家" FontSize="17" FontWeight="Bold"/>
                <TextBlock x:Name="VersionText" Text="版本 1.0.0" FontSize="12" Margin="0,3,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Text="主要功能" FontWeight="Bold"/>
                <TextBlock Margin="0,7,0,0" LineHeight="22" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="· 按作用域分类管理右键菜单（目录 / 背景 / 文件夹 / 文件 / 扩展名）&#x0a;· 新增、修改、删除菜单项，自定义图标（内置 / 系统 / 图片）&#x0a;· 内置系统功能快捷模板（环境变量、hosts、组策略、CMD 等）&#x0a;· 常用后缀默认程序查看与修改&#x0a;· 小工具：窗口置顶、密码速记框、重启资源管理器等"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0"
                Background="#FFFBEB" BorderBrush="#FDE68A">
            <StackPanel>
                <TextBlock Text="温馨提示" FontWeight="Bold" Foreground="#92400E"/>
                <TextBlock Margin="0,7,0,0" LineHeight="21" FontSize="12" TextWrapping="Wrap"
                           Foreground="#78500E"
                           Text="· Windows 11 中，自定义菜单显示在右键菜单的「显示更多选项」中（或 Shift+右键）。&#x0a;· 标记为「系统」的菜单项属于所有用户，修改 / 删除需管理员权限。&#x0a;· 注册表操作请谨慎，建议删除前先确认菜单项用途。"/>
            </StackPanel>
        </Border>

        <Button Style="{StaticResource RoundedButton}" Click="Close_Click" HorizontalAlignment="Right"
                Margin="0,18,0,0" Padding="24,7">
            <TextBlock Text="关闭"/>
        </Button>
    </StackPanel>
</Window>
