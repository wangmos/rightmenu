<Window x:Class="RightMenuMaster.Views.PasswordNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="密码速记框" Width="380" Height="250"
        WindowStartupLocation="CenterScreen" Background="#F7F9FC"
        ResizeMode="CanMinimize" Topmost="True">

    <DockPanel Margin="14,12">
        <!-- 底部按钮 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <DockPanel>
                <CheckBox x:Name="TopCheck" IsChecked="True" Checked="TopCheck_Changed"
                          Unchecked="TopCheck_Changed" VerticalAlignment="Center">
                    <TextBlock Text="窗口置顶" FontSize="12"/>
                </CheckBox>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <ComboBox x:Name="LenCombo" Width="70" SelectedIndex="1" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource RoundedButton}" Click="Generate_Click"
                            Margin="6,0,0,0" Padding="10,4" FontSize="12">
                        <TextBlock Text="生成随机"/>
                    </Button>
                </StackPanel>
            </DockPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Style="{StaticResource RoundedButton}" Click="Toggle_Click" Padding="12,5" FontSize="12">
                    <TextBlock x:Name="ToggleText" Text="显示明文"/>
                </Button>
                <Button Style="{StaticResource RoundedButton}" Click="Copy_Click" Margin="8,0,0,0"
                        Padding="12,5" FontSize="12">
                    <TextBlock Text="复制"/>
                </Button>
                <Button Style="{StaticResource DangerButton}" Click="Clear_Click" Margin="8,0,0,0"
                        Padding="12,5" FontSize="12">
                    <TextBlock Text="清空"/>
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- 输入区 -->
        <Border Style="{StaticResource Card}" Padding="10">
            <Grid>
                <TextBox x:Name="PlainBox" FontFamily="Consolas" FontSize="15"
                         Visibility="Collapsed" VerticalContentAlignment="Center"
                         ToolTip="明文模式"/>
                <PasswordBox x:Name="MaskedBox" FontFamily="Consolas" FontSize="15"
                             VerticalContentAlignment="Center"
                             ToolTip="隐藏模式"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
