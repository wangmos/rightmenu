<Window x:Class="RightMenuMaster.Views.LlmSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 接口设置 - 右键菜单管家" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F7F9FC">

    <StackPanel Margin="22,18">
        <TextBlock Text="大模型接口设置" FontSize="17" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,6,0,0"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="兼容 OpenAI 格式的 chat/completions 接口（OpenAI、DeepSeek、Moonshot、各类中转站等）。设置保存在程序目录。"/>

        <TextBlock Text="API 地址" Margin="0,14,0,0" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox x:Name="BaseUrlBox" Margin="0,5,0,0"
                 Tag="例如 https://api.openai.com/v1 或 https://api.deepseek.com"/>

        <TextBlock Text="API Key" Margin="0,12,0,0" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
        <PasswordBox x:Name="KeyBox" Margin="0,5,0,0" Padding="9,6" FontSize="13"/>

        <TextBlock Text="模型名称" Margin="0,12,0,0" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox x:Name="ModelBox" Margin="0,5,0,0"
                 Tag="例如 gpt-4o-mini、deepseek-chat、moonshot-v1-8k"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="22,8">
                <TextBlock Text="保存"/>
            </Button>
            <Button x:Name="BtnCancel" Style="{StaticResource RoundedButton}" Click="Cancel_Click"
                    Margin="10,0,0,0" Padding="22,8">
                <TextBlock Text="取消"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
