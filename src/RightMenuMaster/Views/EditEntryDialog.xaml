<Window x:Class="RightMenuMaster.Views.EditEntryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑菜单项" Width="940" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F7F9FC">

    <Grid Margin="22,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <!-- 底部按钮 -->
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnSave" Style="{StaticResource PrimaryButton}" Click="Save_Click" Padding="22,8">
                    <TextBlock Text="保存"/>
                </Button>
                <Button x:Name="BtnCancel" Style="{StaticResource RoundedButton}" Click="Cancel_Click" Margin="10,0,0,0" Padding="22,8">
                    <TextBlock Text="取消"/>
                </Button>
            </StackPanel>

            <StackPanel>
                <TextBlock x:Name="DialogTitle" Text="新增菜单项" FontSize="17" FontWeight="Bold"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ExtRow" Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="ProgramRow" Height="Auto"/>
                        <RowDefinition x:Name="ArgsRow" Height="Auto"/>
                        <RowDefinition x:Name="ScriptRow" Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 作用域 -->
                    <TextBlock Grid.Row="0" Text="作用域" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="CategoryCombo" Grid.Row="0" Grid.Column="1"
                              DisplayMemberPath="Name" SelectionChanged="CategoryCombo_Changed"/>

                    <!-- 扩展名 -->
                    <TextBlock Grid.Row="2" Text="扩展名" VerticalAlignment="Center" Margin="0,12,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                        <TextBox x:Name="ExtBox" Width="140" HorizontalAlignment="Left"/>
                        <TextBlock Text="以点开头，例如 .txt" FontSize="11" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- 标题 -->
                    <TextBlock Grid.Row="3" Text="标题 *" VerticalAlignment="Center" Margin="0,12,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="TitleBox" Grid.Row="3" Grid.Column="1" Margin="0,12,0,0"/>

                    <!-- 命令类型 -->
                    <TextBlock Grid.Row="4" Text="命令类型" VerticalAlignment="Center" Margin="0,12,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="CommandTypeCombo" Grid.Row="4" Grid.Column="1" Margin="0,12,0,0"
                              Width="200" HorizontalAlignment="Left"
                              DisplayMemberPath="Name" SelectionChanged="CommandTypeCombo_Changed"/>

                    <!-- 图标 -->
                    <TextBlock Grid.Row="5" Text="图标" VerticalAlignment="Top" Margin="0,14,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,14,0,0" Orientation="Horizontal">
                        <Border Width="42" Height="42" CornerRadius="8" Background="White"
                                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1">
                            <Image x:Name="IconPreview" Width="30" Height="30"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource RoundedButton}" Click="PickIcon_Click" Padding="12,5">
                                    <TextBlock Text="选择图标…"/>
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" Click="ClearIcon_Click"
                                        Margin="8,0,0,0" Padding="10,5">
                                    <TextBlock Text="清除"/>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="IconPathText" FontSize="10.5" Margin="1,5,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       MaxWidth="400" TextTrimming="CharacterEllipsis"
                                       Text="（未设置，使用系统默认图标）"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 程序 -->
                    <TextBlock Grid.Row="6" Text="程序 *" VerticalAlignment="Center" Margin="0,14,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,14,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource RoundedButton}"
                                Click="BrowseProgram_Click" Padding="12,5" Margin="8,0,0,0">
                            <TextBlock Text="浏览…"/>
                        </Button>
                        <TextBox x:Name="ProgramBox"/>
                    </DockPanel>

                    <!-- 参数 -->
                    <TextBlock Grid.Row="7" Text="参数" VerticalAlignment="Center" Margin="0,12,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,12,0,0">
                        <TextBox x:Name="ArgsBox" FontFamily="Consolas"/>
                        <TextBlock FontSize="11" Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="占位符：%1 = 选中的文件/文件夹；%V = 当前目录（用于「目录背景」）；%L = 长路径"/>
                    </StackPanel>

                    <!-- 命令内容（CMD / PowerShell） -->
                    <TextBlock Grid.Row="8" Text="命令内容 *" VerticalAlignment="Top" Margin="0,14,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,14,0,0">
                        <TextBox x:Name="ScriptBox" Style="{StaticResource MultiLineTextBox}"
                                 Height="88" FontFamily="Consolas" Padding="8,6"/>
                        <TextBlock x:Name="ScriptHint" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- 显示位置 -->
                    <TextBlock Grid.Row="9" Text="显示位置" VerticalAlignment="Center" Margin="0,12,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="PositionCombo" Grid.Row="9" Grid.Column="1" Margin="0,12,0,0"
                              Width="160" HorizontalAlignment="Left"/>

                    <!-- 选项 -->
                    <TextBlock Grid.Row="10" Text="选项" VerticalAlignment="Center" Margin="0,14,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <StackPanel Grid.Row="10" Grid.Column="1" Margin="0,14,0,0">
                        <CheckBox x:Name="ShiftCheck" Content="仅按住 Shift 键右键时显示"/>
                        <CheckBox x:Name="NoWorkDirCheck" Content="不设置工作目录（NoWorkingDirectory）" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </DockPanel>

        <!-- ============ 右侧：AI 智能填写 ============ -->
        <Border x:Name="AiPanel" Grid.Column="1" Width="280" Margin="22,0,0,0"
                Background="White" CornerRadius="10" BorderThickness="1"
                BorderBrush="{StaticResource BorderBrushLight}" Padding="16,14">
            <DockPanel>
                <!-- 顶部：标题 + 醒目的接口设置按钮 -->
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="AI 智能填写" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button x:Name="BtnAiSettings" Style="{StaticResource RoundedButton}"
                                Background="{StaticResource AccentLightBrush}"
                                BorderBrush="{StaticResource AccentBrush}"
                                Foreground="{StaticResource AccentBrush}"
                                FontWeight="SemiBold" Padding="10,4"
                                Margin="12,0,0,0" Click="AiSettings_Click" VerticalAlignment="Center"
                                ToolTip="设置大模型 API 地址与密钥">
                            <TextBlock Text="接口设置" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,10"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="用一句话描述想要的菜单功能，大模型会自动填好左侧的作用域、命令类型、程序/命令、图标等。"/>
                </StackPanel>
                <!-- 底部：生成按钮与状态 -->
                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="BtnAiGenerate" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="0,8"
                            Click="AiGenerate_Click">
                        <TextBlock x:Name="AiGenerateText" Text="生成菜单定义"/>
                    </Button>
                    <TextBlock x:Name="AiStatusText" TextWrapping="Wrap" FontSize="11"
                               Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
                <!-- 中部：描述输入框撑满剩余高度 -->
                <TextBox x:Name="AiDescBox" Style="{StaticResource MultiLineTextBox}"
                         Padding="8,6" VerticalAlignment="Stretch"
                         Tag="例如：右键空白处出现「用 VSCode 打开」，在当前目录运行 code ."/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
