<Window x:Class="RightMenuMaster.Views.TopMostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="窗口置顶工具" Width="660" Height="540" MinWidth="620"
        WindowStartupLocation="CenterOwner" Background="#F7F9FC">

    <DockPanel Margin="16,14">
        <!-- 顶部 -->
        <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Style="{StaticResource RoundedButton}"
                    Click="Refresh_Click" Padding="14,6">
                <TextBlock Text="刷新列表"/>
            </Button>
            <TextBlock Text="双击窗口行或拨动开关，使其保持在最前 / 取消置顶"
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </DockPanel>

        <!-- 状态 -->
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="2,8,0,0" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"/>

        <!-- 列表 -->
        <Border Style="{StaticResource Card}" Padding="6,8" Margin="0,12,0,0">
            <ListView x:Name="WinList" Style="{StaticResource EntryListView}"
                      MouseDoubleClick="WinList_DoubleClick">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                        <GridViewColumn Header="窗口标题" Width="300">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTip="{Binding Title}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="进程" Width="130">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProcessName}" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="置顶" Width="116">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox Style="{StaticResource SwitchCheckBox}"
                                              VerticalAlignment="Center"
                                              Tag="{Binding}"
                                              Checked="TopMostSwitch_Change" Unchecked="TopMostSwitch_Change"
                                              ToolTip="开关 = 置顶 / 取消置顶"
                                              IsChecked="{Binding IsTopMost, Mode=OneTime}">
                                        <TextBlock FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="普通"/>
                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTopMost}" Value="True">
                                                            <Setter Property="Text" Value="已置顶"/>
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </DockPanel>
</Window>
