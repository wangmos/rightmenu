<Window x:Class="RightMenuMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:RightMenuMaster.Helpers"
        Title="右键菜单管家" Height="730" Width="1180"
        MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringToVisibilityConverter x:Key="StrToVis"/>
        <helpers:InverseBoolConverter x:Key="InvBool"/>

        <!-- 可点击卡片 -->
        <Style x:Key="HoverCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#9DBDF5"/>
                    <Setter Property="Background" Value="#FBFCFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 侧边栏图标 -->
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>

        <!-- 工具页卡片 -->
        <Style x:Key="ToolCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================ 侧边栏 ============================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource AccentBrush}">
                            <Path Data="M5,3 L14,12 L10.5,12.8 L13,18.2 L10.6,19.3 L8.2,13.9 L5,16.5 Z"
                                  Fill="White" Stretch="Uniform" Width="17" Height="17"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="右键菜单管家" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="RightMenu Master" Foreground="#6E7A8F" FontSize="10"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 底部：权限与关于 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <Border CornerRadius="8" Background="#262C3A" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="AdminDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="AdminText" Text="普通权限" Foreground="#B8C0CE"
                                           FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="AdminButton" Click="AdminButton_Click" Cursor="Hand"
                                    Margin="0,7,0,0" Padding="8,5" FontSize="11.5"
                                    Foreground="White" Background="{StaticResource AccentBrush}"
                                    BorderThickness="0" Style="{StaticResource RoundedButton}">
                                <TextBlock Text="以管理员身份重启" FontSize="11.5"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Click="About_Click" Cursor="Hand" Padding="8,6"
                            Foreground="#8B94A5" Background="Transparent" BorderThickness="0"
                            Style="{StaticResource RoundedButton}" HorizontalAlignment="Left">
                        <TextBlock Text="关于本软件" FontSize="12"/>
                    </Button>
                </StackPanel>

                <!-- 导航 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,0">
                        <TextBlock Text="菜单管理" Style="{StaticResource GroupHeader}"/>

                        <RadioButton x:Name="NavBackground" Style="{StaticResource NavButton}"
                                     Tag="Background" IsChecked="True" Checked="NavScope_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" StrokeThickness="1.8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,4.5 H21 V19.5 H3 Z" Fill="Transparent" StrokeDashArray="2.4,1.6"/>
                                <TextBlock Text="目录背景" Margin="9,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" Tag="Directory" Checked="NavScope_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M3,6 L9,6 L11,8.5 L21,8.5 L21,19 L3,19 Z"/>
                                <TextBlock Text="目录" Margin="9,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" Tag="Folder" Checked="NavScope_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}" StrokeThickness="1.8"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      Data="M3,5.5 L9.5,5.5 L11.5,8 L21,8 L21,19 L3,19 Z" Fill="Transparent"/>
                                <TextBlock Text="文件夹" Margin="9,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavButton}" Tag="File" Checked="NavScope_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M6,2 L14,2 L19,7 L19,22 L6,22 Z"/>
                                <TextBlock Text="文件" Margin="9,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavExtension" Style="{StaticResource NavButton}"
                                     Tag="Extension" Checked="NavScope_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="16" Height="16">
                                    <Path Style="{StaticResource NavIcon}"
                                          Data="M6,2 L14,2 L19,7 L19,22 L6,22 Z"/>
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                </Grid>
                                <TextBlock Text="指定扩展名" Margin="9,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="更多功能" Style="{StaticResource GroupHeader}"/>

                        <RadioButton x:Name="NavTemplates" Style="{StaticResource NavButton}"
                                     Tag="templates" Checked="NavPage_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M13,2 L5,13 L11,13 L9,22 L19,10 L12.5,10 Z"/>
                                <TextBlock Text="快捷模板" Margin="9,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavDefaults" Style="{StaticResource NavButton}"
                                     Tag="defaults" Checked="NavPage_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M4,4 h7 v7 h-7 z M13,4 h7 v7 h-7 z M4,13 h7 v7 h-7 z M13,13 h7 v7 h-7 z"/>
                                <TextBlock Text="默认程序" Margin="9,0,0,0"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="NavTools" Style="{StaticResource NavButton}"
                                     Tag="tools" Checked="NavPage_Checked">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{StaticResource NavIcon}"
                                      Data="M4,9.5 H20 V19 H4 Z M9,9.5 V6.5 H15 V9.5"/>
                                <TextBlock Text="小工具箱" Margin="9,0,0,0"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================ 主内容区 ============================ -->
        <Grid Grid.Column="1">

            <!-- ============ 页面：菜单管理 ============ -->
            <Grid x:Name="PageMenus">
                <DockPanel Margin="26,22,26,14">
                    <!-- 标题 -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="MenuPageTitle" Text="目录背景" Style="{StaticResource PageTitle}"/>
                        <TextBlock x:Name="MenuPageSubtitle" Text="在文件夹空白处右键时出现的菜单"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>

                    <!-- 工具栏：搜索框固定靠右，按钮区自动换行，永不重叠 -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,16,0,12">
                        <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="220" Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 TextChanged="Search_TextChanged"
                                 ToolTip="按标题或命令筛选"/>
                        <WrapPanel>
                            <Button x:Name="BtnAdd" Style="{StaticResource PrimaryButton}" Click="Add_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋" Margin="0,-1,6,0" FontWeight="Bold"/>
                                    <TextBlock Text="新增菜单"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnEdit" Style="{StaticResource RoundedButton}" Click="Edit_Click" Margin="8,0,0,0">
                                <TextBlock Text="编辑"/>
                            </Button>
                            <Button x:Name="BtnDelete" Style="{StaticResource DangerButton}" Click="Delete_Click" Margin="8,0,0,0">
                                <TextBlock Text="删除"/>
                            </Button>
                            <Button x:Name="BtnRefresh" Style="{StaticResource RoundedButton}" Click="Refresh_Click" Margin="8,0,0,0">
                                <TextBlock Text="刷新"/>
                            </Button>
                            <Border Width="1" Background="{StaticResource BorderBrushLight}" Margin="12,4"/>
                            <Button x:Name="BtnExport" Style="{StaticResource RoundedButton}" Click="Export_Click" Margin="12,0,0,0">
                                <TextBlock Text="导出"/>
                            </Button>
                            <Button x:Name="BtnImport" Style="{StaticResource RoundedButton}" Click="Import_Click" Margin="8,0,0,0">
                                <TextBlock Text="导入"/>
                            </Button>
                            <Border Width="1" Background="{StaticResource BorderBrushLight}" Margin="12,4"/>
                            <Button x:Name="BtnSelectAll" Style="{StaticResource RoundedButton}" Click="SelectAll_Click"
                                    Margin="12,0,0,0" ToolTip="选中当前列表全部项；已全部选中时点击则取消全选">
                                <TextBlock Text="全选"/>
                            </Button>
                        </WrapPanel>
                    </DockPanel>

                    <!-- 扩展名选择 -->
                    <Border x:Name="ExtSelector" DockPanel.Dock="Top" Style="{StaticResource Card}"
                            Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="扩展名：" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox x:Name="ExtCombo" Width="150" IsEditable="True" Margin="0,0,10,0"/>
                            <Button Style="{StaticResource RoundedButton}" Click="ExtApply_Click" Padding="12,5">
                                <TextBlock Text="查看"/>
                            </Button>
                            <TextBlock Text="输入或选择扩展名（如 .txt），管理仅对该类型文件生效的菜单"
                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- 状态栏 -->
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="6,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>

                    <!-- 列表 -->
                    <Border Style="{StaticResource Card}" Padding="6,8">
                        <ListView x:Name="EntryList" Style="{StaticResource EntryListView}"
                                  SelectionMode="Extended"
                                  MouseDoubleClick="EntryList_DoubleClick">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="编辑" Click="Edit_Click"/>
                                    <MenuItem Header="启用/禁用" Click="ToggleDisabled_Click"/>
                                    <MenuItem Header="删除" Click="Delete_Click"/>
                                    <Separator/>
                                    <MenuItem Header="复制为当前用户项（便于修改系统项）" Click="CopyToUser_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                                    <GridViewColumn Header="" Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          ToolTip="勾选 = 选中该项（配合工具栏按钮批量操作）"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay,
                                                              RelativeSource={RelativeSource AncestorType=ListViewItem}}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="" Width="46">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding Icon}" Width="24" Height="24"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="标题" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="126"/>
                                                    <Border Style="{StaticResource Badge}" Background="#F1E8FF"
                                                            Margin="6,0,0,0"
                                                            Visibility="{Binding IsCascade, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="级联" Foreground="#7C3AED" FontSize="10.5"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Background="#E0F2FE"
                                                            Margin="6,0,0,0"
                                                            ToolTip="Shell 扩展：由 COM 组件提供的右键功能"
                                                            Visibility="{Binding IsShellExtension, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="扩展" Foreground="#0369A1" FontSize="10.5"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="命令" Width="280">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Command}"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           ToolTip="{Binding Command}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="选项" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Style="{StaticResource Badge}" Background="#FEF3C7"
                                                            Visibility="{Binding ShiftExtended, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Shift" Foreground="#B45309" FontSize="10.5"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Background="#DBEAFE"
                                                            Margin="4,0,0,0"
                                                            Visibility="{Binding Position, Converter={StaticResource StrToVis}}">
                                                        <TextBlock Text="{Binding Position}" Foreground="#1D4ED8" FontSize="10.5"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="状态" Width="104">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource SwitchCheckBox}"
                                                          VerticalAlignment="Center"
                                                          Tag="{Binding}"
                                                          Checked="StatusSwitch_Change" Unchecked="StatusSwitch_Change"
                                                          ToolTip="开关 = 生效 / 失效"
                                                          IsChecked="{Binding IsDisabled, Mode=OneTime,
                                                              Converter={StaticResource InvBool}}">
                                                    <TextBlock FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="已生效"/>
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                        <Setter Property="Text" Value="已禁用"/>
                                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </CheckBox>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="来源" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source}" Value="LocalMachine">
                                                                    <Setter Property="Background" Value="#FFE4E6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="用户"/>
                                                                <Setter Property="Foreground" Value="#15803D"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Source}" Value="LocalMachine">
                                                                        <Setter Property="Text" Value="系统"/>
                                                                        <Setter Property="Foreground" Value="#BE123C"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- ============ 页面：快捷模板 ============ -->
            <Grid x:Name="PageTemplates" Visibility="Collapsed">
                <DockPanel Margin="26,22,26,14">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="快捷模板" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="挑选内置的系统功能，一键生成右键菜单；先点「运行看效果」预览，也可在打开的编辑窗口中调整后保存"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TemplateList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverCard}" Width="258" Padding="16"
                                            Margin="0,0,14,14" MouseLeftButtonUp="TemplateCard_Click">
                                        <StackPanel>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}"
                                                        Background="#F1F5F9" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Group}" FontSize="10.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                                <Border Width="34" Height="34" CornerRadius="8"
                                                        Background="{StaticResource AccentLightBrush}">
                                                    <Path Data="M13,2 L5,13 L11,13 L9,22 L19,10 L12.5,10 Z"
                                                          Fill="{StaticResource AccentBrush}"
                                                          Stretch="Uniform" Width="16" Height="16"/>
                                                </Border>
                                            </DockPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13.5"
                                                       Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       MaxHeight="34"/>
                                            <TextBlock Text="{Binding Command}" FontSize="10.5" Margin="0,8,0,0"
                                                       Foreground="#9AA3B2" TextTrimming="CharacterEllipsis"
                                                       FontFamily="Consolas"
                                                       ToolTip="{Binding Command}"/>
                                            <Button Style="{StaticResource SubtleButton}" Click="TemplateRun_Click"
                                                    Tag="{Binding}" Cursor="Hand" Padding="10,3" Margin="0,10,0,0"
                                                    HorizontalAlignment="Left" FontSize="11.5"
                                                    ToolTip="用真实路径实际运行一次，预览效果">
                                                <TextBlock Text="▶ 运行看效果"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- ============ 页面：默认程序 ============ -->
            <Grid x:Name="PageDefaults" Visibility="Collapsed">
                <DockPanel Margin="26,22,26,14">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="默认程序" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="查看并修改各类型文件的默认打开程序（修改通过系统「打开方式」对话框完成）"
                                   Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,16,0,12">
                        <TextBox x:Name="ExtFilterBox" Width="220" TextChanged="ExtFilter_Changed"
                                 Tag="筛选扩展名或说明，例如 .txt" ToolTip="筛选扩展名或说明"/>
                        <Button Style="{StaticResource RoundedButton}" Click="OpenSystemDefaultApps_Click"
                                HorizontalAlignment="Right">
                            <TextBlock Text="打开系统默认应用设置"/>
                        </Button>
                    </DockPanel>
                    <Border Style="{StaticResource Card}" Padding="6,8">
                        <ListView x:Name="ExtList" Style="{StaticResource EntryListView}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource FlatHeader}">
                                    <GridViewColumn Header="扩展名" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource AccentLightBrush}"
                                                        CornerRadius="5" Padding="8,3" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Ext}" FontWeight="Bold"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontFamily="Consolas"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="说明" Width="180">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Description}" VerticalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="当前默认程序" Width="260">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DefaultApp}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="操作" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PrimaryButton}" Padding="10,4"
                                                        FontSize="12" Click="ChangeDefault_Click"
                                                        Tag="{Binding Ext}">
                                                    <TextBlock Text="更改…"/>
                                                </Button>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </DockPanel>
            </Grid>

            <!-- ============ 页面：小工具箱 ============ -->
            <Grid x:Name="PageTools" Visibility="Collapsed">
                <DockPanel Margin="26,22,26,14">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="小工具箱" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="一些实用的小功能" Style="{StaticResource PageSubtitle}"/>
                    </StackPanel>
                    <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                        <WrapPanel>
                            <!-- 窗口置顶 -->
                            <Border Style="{StaticResource ToolCard}">
                                <StackPanel>
                                    <TextBlock Text="窗口置顶" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="让任意窗口保持在最前面，不再被其他窗口遮挡"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource PrimaryButton}" Click="OpenTopMost_Click"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="打开置顶工具"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 密码速记框 -->
                            <Border Style="{StaticResource ToolCard}">
                                <StackPanel>
                                    <TextBlock Text="密码速记框" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="置顶的浮动小框，临时粘贴/输入密码，可隐藏、复制与生成随机密码"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource PrimaryButton}" Click="OpenPasswordBox_Click"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="打开速记框"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 重启资源管理器 -->
                            <Border Style="{StaticResource ToolCard}">
                                <StackPanel>
                                    <TextBlock Text="重启资源管理器" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="右键菜单没有立即出现、任务栏卡顿时，重启 explorer 通常能解决"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource RoundedButton}" Click="RestartExplorer_Click"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="立即重启"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 显示隐藏文件 -->
                            <Border Style="{StaticResource ToolCard}">
                                <StackPanel>
                                    <TextBlock Text="显示隐藏文件" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="一键开关资源管理器中的隐藏文件显示"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="HiddenSwitch" Style="{StaticResource SwitchCheckBox}"
                                              Checked="HiddenSwitch_Changed" Unchecked="HiddenSwitch_Changed">
                                        <TextBlock Text="显示隐藏的项目"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- 显示扩展名 -->
                            <Border Style="{StaticResource ToolCard}">
                                <StackPanel>
                                    <TextBlock Text="显示文件扩展名" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="一键开关文件名后缀（.txt / .exe 等）的显示"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"/>
                                    <CheckBox x:Name="ExtSwitch" Style="{StaticResource SwitchCheckBox}"
                                              Checked="ExtSwitch_Changed" Unchecked="ExtSwitch_Changed">
                                        <TextBlock Text="显示已知文件扩展名"/>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- 轻提示 -->
            <Border x:Name="Toast" CornerRadius="8" Background="#1F2937" Opacity="0"
                    Padding="16,10" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,26" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" Foreground="White" FontSize="13"/>
            </Border>
        </Grid>
    </Grid>
</Window>
